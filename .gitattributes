# Normalize source files to LF in the repository.
* text=auto eol=lf

# The original blackfriday golden files are byte-for-byte fixtures. Any EOL
# translation on checkout makes the upstream Go suite fail with phantom \r
# diffs (expected "...\r\n" vs actual "...\n"), which looks like a port bug
# but is purely a checkout artifact. Store and emit these verbatim.
tests/original/testdata/** -text
tests/original/**.go      -text

# The bug 5 reproducer is exactly eight bytes and its CR is load-bearing: the
# hang does not happen without it. EOL translation on checkout would silently
# turn the reproducer into something that works.
docs/repro/** -text

*.png binary
